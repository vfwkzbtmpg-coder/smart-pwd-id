# =====================================================================
#  SMART PWD ID · ADMIN REACT CONSOLE — ENVIRONMENT TEMPLATE (.env.example)
# =====================================================================
#
# INSTRUCTIONS:
#   1. Copy this file to a NEW file named exactly ".env" (no .txt, no .example)
#   2. Replace every placeholder below with real values from your Supabase project.
#   3. NEVER commit the real ".env" to version control (it is already in .gitignore).
#
# SECURITY RULES — READ BEFORE EDITING:
#   ✅ USE ONLY the "anon" / "Publishable" key in this React frontend file.
#   ❌ NEVER paste the "service_role" key, JWT secret, or DB password here.
#      Those belong ONLY on the server side (server.js / .env in project root).
#
# WHERE TO FIND THESE VALUES:
#   Supabase Dashboard → Project Settings → API
#     → Project URL            = VITE_SUPABASE_URL
#     → anon public key        = VITE_SUPABASE_PUBLISHABLE_KEY
# =====================================================================

# ---------------------------
#  REQUIRED (2 values)
# ---------------------------

# VITE_SUPABASE_URL
#   The full public URL of your Supabase project, as shown on the API page.
#   Format:  https://<your-project-ref>.supabase.co
#   Example: https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# VITE_SUPABASE_PUBLISHABLE_KEY
#   Supabase "anon" / "Publishable" / "Public" key. Safe to ship to browsers.
#   This is a ~80-character long string starting with "eyJhbGciOiJIUzI1NiIs..."
#   DO NOT USE service_role here — if you do, anyone using the admin console
#   can bypass RLS and read/write everything in your DB.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_ANON_KEY_HERE

# ---------------------------
#  OPTIONAL (customization)
# ---------------------------

# VITE_APP_TITLE
#   Brand name displayed on the login screen, sidebar, and page headers.
#   Default (if unset): "Smart PWD ID Admin Console"
VITE_APP_TITLE=Smart PWD ID Admin Console

# VITE_ADMIN_ROLE_NAME
#   The role string stored in  public.profiles.role  that grants access to
#   this console. Auth is rejected if the signed-in user's profile.role
#   does not match (case-insensitive).
#   Default (if unset): "admin"
#
#   Matching examples (any of these profiles.role values will be accepted):
#     "admin"  /  "Admin"  /  "ADMIN"
VITE_ADMIN_ROLE_NAME=admin

# ---------------------------
#  TROUBLESHOOTING
# ---------------------------
#
#  Q: The login form says "Missing configuration"?
#  A: You didn't copy this file to ".env" or left the URL/anon key as placeholders.
#
#  Q: I sign in successfully but it boots me out with "Administrator access only"?
#  A: Your auth.users record exists, but public.profiles.role is not set to
#     "admin" (or whatever VITE_ADMIN_ROLE_NAME is).  Run:
#
#         update public.profiles set role = 'admin' where id = '<your-auth-users-id>';
#
#  Q: Dashboard/applications show 0 rows even though rows exist?
#  A: RLS policies on pwd_applications and profiles are missing.  Apply the
#     migrations in /supabase/ against your database, especially
#     004_rls_admin_applications.sql.
#
#  Q: Changes to .env aren't taking effect?
#  A: Stop the dev server (Ctrl+C) and run "npm run dev" again — Vite only
#     reads .env at startup.
# =====================================================================
