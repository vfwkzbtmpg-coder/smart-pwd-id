# ---------------------------------------------------------------
# Bundled Windows Python runtime for the NFC kiosk.
# The Raspberry Pi runs its own python3, so this is machine-local
# and would add ~160 MB of binaries to the repository.
# ---------------------------------------------------------------
public/nfc/**/_python/
__pycache__/
*.pyc

